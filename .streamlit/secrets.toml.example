# Copy to .streamlit/secrets.toml and edit (that file is gitignored).
# On Streamlit Community Cloud, paste these lines into Settings -> Secrets.
#
# A local Ollama run needs NONE of this. It is only for a hosted backend,
# which is what a deployed app has to use -- a container cannot reach your
# laptop's Ollama server. One key is enough; add more to switch in the sidebar.

# GROQ_API_KEY = "gsk_..."           # free tier, https://console.groq.com/keys
# GEMINI_API_KEY = "AIza..."         # free tier, https://aistudio.google.com/apikey
# OPENAI_API_KEY = "sk-..."          # paid, https://platform.openai.com/api-keys
# ANTHROPIC_API_KEY = "sk-ant-..."   # paid, https://console.anthropic.com/settings/keys

# Optional: pin the backend instead of letting the app work it out.
# PETBARN_PROVIDER = "groq"
