# Copy to .streamlit/secrets.toml and edit (that file is gitignored).
# On Streamlit Community Cloud, paste these lines into Settings -> Secrets.
#
# A local Ollama run needs NONE of this. It is only for the hosted backend,
# which is what a deployed app has to use -- a container cannot reach your
# laptop's Ollama server.

# PETBARN_PROVIDER = "groq"
# GROQ_API_KEY = "gsk_your_key_here"
