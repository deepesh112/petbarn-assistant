# Optional environment overrides. Copy to .env and edit, or export directly.
# Nothing here is required for a local Ollama run -- that works with no config.

# Which model backend to use: "ollama" (local, offline, default) or "groq" (hosted).
# A deployed app must set this to groq: a hosted container cannot reach your laptop.
PETBARN_PROVIDER=ollama

# Where the local Ollama server listens. The /v1 suffix is its OpenAI-compatible
# endpoint, which is what this app speaks.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only needed when PETBARN_PROVIDER=groq. Free keys: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_key_here

# Set to 0 to answer only from the committed snapshot and never touch the
# network. Combined with Ollama, the whole app then runs fully offline.
PETBARN_LIVE=1

# Bazaarvoice display passkey. Normally discovered at runtime from Petbarn's own
# page bundle; set this only if that discovery breaks.
# BV_PASSKEY=

# How long a cached HTTP response stays fresh, in seconds (default 21600 = 6h).
# PETBARN_CACHE_TTL=21600

# Minimum seconds between requests to the same host (default 1.0).
# PETBARN_MIN_INTERVAL=1.0

# Seconds to wait for a model response (default 180; local models are slow).
# PETBARN_LLM_TIMEOUT=180
